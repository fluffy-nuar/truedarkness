  "workspaceSettings": {
    "modid": "truedarkness",
    "modName": "True Darkness Elementriy",
    "version": "1.11.0",
    "description": "§8Welcome to the world of Elementry. This is a place where even the strangest and most incomprehensible things take on a double meaning. In True Darkness, you will be able to imagine the world from which sculk got out (or is it not him yet?). You will be able to travel through the lavender fields or make delicious tea. Create new sets of armor, and maybe unravel the mystery of a long-dying world? It\u0027s up to you! The mod is in development, so it\u0027s worth getting ready for future content.",
    "author": "FLuffy_Nuar",
    "websiteURL": "https://www.curseforge.com/minecraft/mc-mods/true-darkness-elementriy",
    "license": "All Rights Reserved",
    "disableForgeVersionCheck": true,
    "serverSideOnly": true,
    "modPicture": "logo_3d_yeee",
    "requiredMods": [],
    "dependencies": [],
    "dependants": [],
    "mcreatorDependencies": [
      "dynamic_lights",
      "curios_api",
      "jei"
    ],
    "currentGenerator": "forge-1.20.1",
    "credits": "§3Fluffy_Nuar, Koshatik",
    "modElementsPackage": "exp.fluffynuar.truedarkness",
    "lockBaseModFiles": false
  },
  "mcreatorVersion": 202300452316
